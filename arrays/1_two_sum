from typing import List 
class Solution:
    def twoSum(self, nums: List[int], target: int) -> List[int]:
        store = {}
        for i in range(len(nums)):
            if target - nums[i] in store:
                return [store[target - nums[i]], i]
            else:
                store[nums[i]] = i

            
