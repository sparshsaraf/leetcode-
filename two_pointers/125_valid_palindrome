class Solution:
    def isPalindrome(self, s: str) -> bool:
        
        """old approach 
        ns = ""
        s = s.lower()
        for c in s:
            if c.isalnum() == True:
                ns = ns + c
            else:
                pass"""
        
        j = len(s) - 1 
        i = 0
        while i < j:
            if s[i].isalnum() == False:
                i += 1 
            elif s[j].isalnum() == False:
                j -= 1 
            else:
                if s[i].lower() == s[j].lower():
                    
                    pass 
                else:
                    return False
                i += 1
                j -= 1

            
        return True 


        
            
        